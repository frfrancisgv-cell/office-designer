# OFFICE_TMPDIR: directory the PDF pipeline uses for its lualatex scratch
# builds (lib/latex/process.ts). Each export gets a fresh subdirectory here,
# removed afterwards. Defaults to /tmp.
#OFFICE_TMPDIR="/tmp"

# DISABLE_HMR: set to "true" to switch off file watching in `next dev`
# (next.config.ts). Only useful when an agent is editing files under you.
#DISABLE_HMR="false"
